# Copia este archivo como application-local.properties y completa los valores vacios.
# No publiques ni compartas la copia que contiene tus claves reales.
# Ejecuta desde esta carpeta:
# java -jar vacantes-escolares.jar --spring.config.additional-location=file:./application-local.properties

spring.datasource.url=jdbc:mysql://127.0.0.1:3306/vacantes_escolares?connectionTimeZone=%2B00:00&forceConnectionTimeZoneToSession=true
spring.datasource.username=vacantes_app
# Tu contrasena de MySQL para vacantes_app.
spring.datasource.password=

# Cuatro contrasenas iniciales del portal. Cada una requiere al menos 10 caracteres.
app.seed.enabled=true
app.seed.admin-password=
app.seed.admissions-password=
app.seed.guardian-password=
app.seed.other-password=

# Google reCAPTCHA v2: casilla No soy un robot, dominios localhost y 127.0.0.1.
app.captcha.mode=google
app.captcha.site-key=
app.captcha.secret-key=
app.captcha.allowed-hostnames=localhost,127.0.0.1

# Ejecucion HTTP local en esta PC.
server.address=127.0.0.1
server.port=8087
server.servlet.session.cookie.secure=false
